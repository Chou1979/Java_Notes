4,0.02829055,-0.04817167,0.05593676,0.02467438,0.02681401,-0.0062666,0.01384993,0.05108048,0.25647855,0.04298128,0.06609453,0.03386472,-0.04779381,0.03572426,0.05714602,-0.04191271,-0.00515118,0.04513147,0.04481064,-0.0194057,0.05252777,0.01764588,-0.03319811,0.02911343,-0.01664359,0.00744716,-0.04002341,0.03025553,-0.07316541,0.03734032,0.15057257,0.02719799,-0.04006312,-0.02636053,-0.00319669,0.02551604,-0.05883887,0.00117831,0.02776645,0.01525037,-0.0258106,0.03491676,0.03312325,-0.05585582,-0.02142861,-0.0285194,-0.01591232,0.00661423,-0.01211871,0.06456767,0.0349531]}},"last_read":{"hash":"5016d5e68848d8dbff443d60d56752c6a5d92c83501e479c4ff2094197b04d08","at":1736691166846},"class_name":"SmartSource","outlinks":[],"last_import":{"mtime":1734966692138,"size":1764,"at":1736691165485,"hash":"5016d5e68848d8dbff443d60d56752c6a5d92c83501e479c4ff2094197b04d08"},"blocks":{"#":[1,1],"#1.  行程":[2,7],"#1.  行程#·  学习了obsidian安装插件，找到了johnny学up主提供的插件网页，终于搞定了插件安装部分；":[3,3],"#1.  行程#·   找到了掌阅smartx3pro划屏的更多帖子，彻底对这款产品祛魅，后续就蹲汉王n10pro或者更好的新品；":[4,7],"#2.   想法及反思":[8,16],"#2.   想法及反思#·  有论点或者疑惑点的时候立刻去求证":[11,16],"#2.   想法及反思#·  有论点或者疑惑点的时候立刻去求证#· （1） 之前在哔站视频的评论里看到了掌阅划屏的观点，当时也看到up主说很多人都反馈了这一点，但并没有去求证，没有找到很多人的言论到底是什么，所以只是留下了一个划屏的概念在，并没有具体的论据，进一步导致对汉王品控失望之后，又燃起了对掌阅的购买欲望；但是今天不死心，去小红书搜到一部分人的真实带图体验帖后，发现掌阅的屏幕盖板是亚克力板，其实就是塑料，所以容易引起划痕（类比生活中的亚克力塑料板，就很容易验证了）就实锤了，完全加深了这个论点。":[12,12],"#2.   想法及反思#·  有论点或者疑惑点的时候立刻去求证#· （2） 经历了（1）的论据寻找之后，彻底坚定了对掌阅的否定，再也不纠结了，所以以后做决策再纠结的时候，要留意以下两个点：1.首先要对关键论点又很高的敏锐度，找到自己最不能接受的点或者会改变决策的点（比如掌阅的屏幕划痕）；2. 去找关键论点的论据，如果能找到佐证观点的真实可信论据，做决策就会变快，减少纠结，并且后续也不会反复横跳。":[13,16],"#3.  每日终极总结":[17,23],"#3.  每日终极总结#·  提高对关键论点的敏锐度，并积极快速寻找论据；":[20,20],"#3.  每日终极总结#·  论点论据相互佐证后，做决策就会变快，且后续反复横跳的情况也会减少；":[21,21],"#3.  每日终极总结#·  继续修炼快速做决策的能力；":[22,23]}},"smart_blocks:2. 日记文件/2024-12-16 周一.md#": {"path":null,"last_embed":{"hash":"07ab59f4731b0790d0acfded6a52d2c53e7e3c6a1e241f6dfe3a41f3072e07fb","tokens":25},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.0579754,-0.00431069,0.02901022,-0.0467