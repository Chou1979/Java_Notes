02888034,-0.05157959,0.02387717,0.01220161,0.07368559,-0.00770445,-0.03862464,-0.02723413,-0.06771144,0.03370652,0.01516571,0.0132126,0.0037432,0.00818991,0.03237195,0.23251028,0.00112174,0.08222862,0.00696763,0.00334114,0.01877993,0.05809184,-0.00139609,-0.02154631,-0.01004102,0.1496172,0.02088736,0.02795903,0.03872678,-0.01621283,0.06750176,-0.04460983,0.01468672,-0.07031991,0.06506814,-0.04406162,0.01140707,0.09400902,0.05830787,-0.04224805,-0.03039077,-0.01479204,0.05825052,0.02564202,-0.00107575,0.02939481,0.03509769,-0.03861403,0.01402783,0.02038257,-0.03876844,-0.0276729,0.00565232,0.01473492,0.02418409,-0.0088321,0.06054682,0.03143591]}},"last_read":{"hash":"0d34bd65a62a355fc0728449e27613f4cb3d98cf831c0170e6623c91d4e87148","at":1755849862478},"class_name":"SmartSource","outlinks":[{"title":"Article","target":"Article","line":1},{"title":"ReadItLater","target":"ReadItLater","line":1},{"title":"神速Hash（下）","target":"https://www.playoffer.cn/3284.html","line":3},{"title":"神速Hash阅读\\","target":"https://www.playoffer.cn/3282.html）\n\n### 链地址法\n\n次日清晨，大臣们按时上朝，接着讨论昨日的话题\n\n“昨日Hash函数的选择我们已经有了具体的方案了，那就只剩下冲突的解决问题了”，王大臣率先发话\n\n“要解决冲突其实也不难，既然会有多个元素被Hash到同一个位置，而这个位置只能存储一个元素，那么我让这个位置可以存储多个元素不就可以了吗？”，何大臣说道\n\n“哦，怎么个弄法？”王大臣问道\n\n“用链表啊，来一个元素加一个，让这个位置存储一个指针，指向一个链表，让所有相同位置的元素都放在这个链表中”，何大臣回答道，接着又画了一个图\n\n![图片](https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649449.png","line":5},{"title":"图片","target":"https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649614.png","line":39},{"title":"图片","target":"https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649893.png","line":51},{"title":"图片","target":"https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649243.png","line":75}],"last_import":{"mtime":1755048681268,"size":6264,"at":1755849860991,"hash":"0d34bd65a62a355fc0728449e27613f4cb3d98cf831c0170e6623c91d4e87148"},"blocks":{"#":[1,2],"#[神速Hash（下）](https://www.playoffer.cn/328