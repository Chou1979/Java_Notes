8,-0.06894021,-0.033514,-0.09052451,0.09308369,-0.00139234,-0.00529721,-0.00867973,-0.0380137,-0.00695556,0.21638875,0.01162293,0.02191392,-0.02085305,0.02913766,0.00930557,0.09874648,0.0487702,-0.00010633,0.02593679,0.09338527,-0.0353442,-0.01545909,0.08663654,0.0008472,0.02685058,0.01074257,-0.01196445,-0.02108766,0.0255057,-0.06730909,-0.00342529,0.1104359,0.02680887,-0.08278392,-0.01397745,0.01407614,0.00933334,-0.01232874,0.02575625,-0.00262487,0.00128439,-0.01994185,0.04926057,0.005079,-0.00380035,0.02652229,-0.00694093,0.0596103,0.01896832,-0.00861095,0.08564401,0.04721068]}},"last_read":{"hash":"4c1a93a83bee853a901fc97433ee64ad56ab017c1a15920767c0bd71f4ec06e6","at":1736691167191},"class_name":"SmartSource","outlinks":[],"last_import":{"mtime":1735966094768,"size":2254,"at":1736691165485,"hash":"4c1a93a83bee853a901fc97433ee64ad56ab017c1a15920767c0bd71f4ec06e6"},"blocks":{"#":[1,1],"#<font color=\"#00b050\">1.  行程</font>":[2,6],"#<font color=\"#00b050\">1.  行程</font>#·   <font color=\"#00b050\">和同事吐槽了周末和妈妈吵架的事情，他们既能表示共情，也在安慰我。</font>":[3,3],"#<font color=\"#00b050\">1.  行程</font>#·   <font color=\"#00b050\">下班路上，，文姐安慰我，要适当向老妈表达脆弱，我说吵架的时候我说了我很受伤，文姐说吵架的时候都在气头上，肯定听不进去，需要后面冷静下来后好好说。感觉文姐说的很有道理，等后面双方都冷静下来以后再认真谈一次。</font>":[4,4],"#<font color=\"#00b050\">1.  行程</font>#<font color=\"#00b050\">·  早上和徐世豪讨论付款免限额校验却漏掉了余额校验的事情时，整个人又陷入了惯性的不服模式，又从客观讨论，过渡到了敏感得主观情绪，认为对方在judge我。</font>":[5,6],"#**<font color=\"#f79646\">2.   想法及反思</font>**":[7,14],"#**<font color=\"#f79646\">2.   想法及反思</font>**#·  <font color=\"#f79646\">客观讨论和主观judge之间的分离</font>":[9,14],"#**<font color=\"#f79646\">2.   想法及反思</font>**#·  <font color=\"#f79646\">客观讨论和主观judge之间的分离</font>#· （1） 确实是我当时的代码写的不够完善，但是被对方直接指出来并提出更好的方法时，我心里虽然认同，但受制于不自信的性格，还是过于敏感地认为对方从客观事实讨论，上升到了主观能力judge，导致我非常抗拒并开启了防御模式。":[10,10],"#**<font color=\"#f79646\">2.   想法及反思</font>**#·  <font color=\"#f79646\">客观讨论和主观judge之间的分离</font>#· （2）其实先承认事实，再交代清楚原本不那么完善的做法的原因和背景就好，并不是最开始没有想到最优方案，只是原本的做法有自己的考量而已，既然现在不再适用了，后续再统一优化就好。法律法条都在不断优化，更何况普通的技术方案，所以没有必要敏感应激直接上升到主观judge，其实对方也没有那个意思，是我自己不够自信。":[11,11],"#**<font color=\"#f79646\">2.   想法及反思</font>**#·  <font color=\"#f79646\">客观讨论和主观judge之间的分离</font>#· （3）真正的自信应该是能很勇敢坦荡地和别人谈论自己的不足，尤其是当别人指出来的时候，更要平静客观。这次我已经比以前进步了，在应激平静下来后，能够主动说出当时那么做的理由，而不是像以前那样憋在心里难受，也算是在补足勇敢坦荡的部分，只是希望以后可以即时平静客观，减少应激防御。":[12,14],"#**<font color=\"#8064a2\">3.  每日终极总结</font>******":[15,18],"#**<font color=\"#8064a2\">3.  每日终极总结</font>******#·  <font color=\"#8064a2\">平静客观地承认自己的不足，减少应激</font>；":[17,18]}},"smart_blocks:2. 日记文件/2024-12-23 周一.md#": {"path":null,"last_embed":{"hash":"07ab59f4731b0790d0acfded6a52d2c53e7e3c6a1e241f6dfe3a41f3072e07fb","tokens":25},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07230385,-0.02399273,0.03001497,-0.05866332,0.05156862,-0.00490849,-0.06691682,-0.01427048,0.02553676,0.00674822,0.00343126,-0.0637712,0.0465753,0.02338586,-0.01391034,-0.0038368,0.00667625,-0.08184418,-0.07342173,-0.00454869,0.1242827,-0.03210913,0.03223797,-0.0811763,0.01575996,0.04041085,-0.02527026,-0.04946929,0.0031135,-0.1443848,-0.03425551,-0.04519719,0.01098089,0.00352309,0.04415051,-0.04520343,-0.01394996,0.02757901,-0.0228108,0.02459907,-0.04045866,0.04063656,0.03152698,-0.0323091,-0.01159879,-0.07717383,-0.06328595,0.01893316,-0.01061542,-0.01996235,-0.0336737,-0.04041072,0.00453069,0.04416546,0.03339443,0.00555706,0.00308442,0.01549317,0.01540112,0.06264559,0.05971634,0.03376523,-0.21671721,0.02169329,0.00289883,0.00944563,-0.03311498,-0.01494389,0.01920397,0.0933349,-0.07142998,0.02687221,0.00959549,0.05647698,0.01497548,-0.0396223,0.00269788,-0.009513,-0.04092229,-0.05336578,-0.01573481,0.05663093,-0.00418549,-0.03108381,-0.0616827,0.00854918,-0.00583597,-0.02442908,-0.01018056,0.00471507,-0.00496929,-0.02512514,0.02788092,0.01704486,-0.05572851,0.01070472,0.03490838,0.00417188,0.01510972,0.1143005,-0.07069542,0.04101622,0.02089289,-0.02788222,0.0032146,-0.01340011,-0.01768331,-0.03568467,0.00481918,-0.03502205,-0.01212029,-0.03988519,0.07797768,-0.0365611,0.02397457,0.02468389,0.060