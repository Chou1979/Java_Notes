780818,0.06908253,-0.00358328,-0.03107868,-0.00124911,-0.00042203,-0.01892898,0.0152509,-0.01344586,-0.26147509,0.01412828,0.01985606,0.03050274,0.01292353,0.01409626,0.03724918,-0.03567242,-0.06314162,0.01129147,-0.05956199,0.05353605,0.00858822,-0.05520394,-0.00419543,-0.07687825,0.09608348,-0.00050993,-0.00389515,-0.0117947,-0.04067868,-0.00994362,0.19800961,-0.00436094,0.0287506,-0.0040919,0.05147693,0.00386912,0.11267269,0.04730687,-0.00021912,0.00263092,0.10130829,-0.05249535,-0.00054377,0.08313256,-0.00041229,0.02637813,-0.00050526,-0.04387245,-0.02446725,0.00637493,-0.07011797,0.00099325,0.1092589,0.03256902,-0.07776846,-0.01984504,0.0177071,0.00495309,0.00247018,0.02387699,-0.0229739,0.00797613,-0.04042557,0.02002169,0.00478711,0.01301841,0.01137161,-0.03356229,0.04009699,0.01929261,-0.0240603,0.11252437,0.04604422]}},"text":null,"length":0,"last_read":{"hash":"3d6f58bd3dbd7c33fdf4e87538c7df7ba4f776dcd8bdbe2af05b6c7251e90120","at":1736691167155},"key":"2. 日记文件/2024-12-23 周一.md#**<font color=\"#f79646\">2.   想法及反思</font>**#·  <font color=\"#f79646\">客观讨论和主观judge之间的分离</font>#· （2）其实先承认事实，再交代清楚原本不那么完善的做法的原因和背景就好，并不是最开始没有想到最优方案，只是原本的做法有自己的考量而已，既然现在不再适用了，后续再统一优化就好。法律法条都在不断优化，更何况普通的技术方案，所以没有必要敏感应激直接上升到主观judge，其实对方也没有那个意思，是我自己不够自信。","lines":[11,11],"size":158,"outlinks":[],"class_name":"SmartBlock"},
"smart_blocks:2. 日记文件/2024-12-23 周一.md#**<font color=\"#f79646\">2.   想法及反思</font>**#·  <font color=\"#f79646\">客观讨论和主观judge之间的分离</font>#· （3）真正的自信应该是能很勇敢坦荡地和别人谈论自己的不足，尤其是当别人指出来的时候，更要平静客观。这次我已经比以前进步了，在应激平静下来后，能够主动说出当时那么做的理由，而不是像以前那样憋在心里难受，也算是在补足勇敢坦荡的部分，只是希望以后可以即时平静客观，减少应激防御。": {"path":null,"last_embed":{"hash":"97602a9bdc610c4679cdb08c8e2ada091fa7b0336d88808d7e23ebc168a7489d","tokens":218},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.09882004,-0.03859178,-0.01081993,-0.03263284,0.03072209,0.00243828,-0.01767479,-0.02815796,0.00572563,0.02482778,0.00164171,-0.07881977,0.04120924,0.00192029,-0.0343637,0.01458082,0.04432169,-0.05984402,-0.06116501,-0.04438679,0.14808679,-0.00860306,0.00040871,-0.08947051,0.01455834,0.04298474,-0.03070352,-0.05005578,0.02788141,-0.14389835,-0.02609931,0.0200964,0.06900866,-0.02006117,0.02832203,-0.03900955,-0.02437936,0.06069427,-0.05049621,-0.00156763,0.01268233,0.02836812,0.0700718,-0.01627722,0.00432919,-0.03982837,-0.00067958,-0.01051608,-0.0316266,-0.05498709,-0.01221566,-0.02784157,-0.00689716,0.025858,-0.0059596,0.03764174,0.0695873,0.00560497,0.02488907,0.00644135,0.04450797,0.03876312,-0.20863809,0.05060819,0.00146508,-0.02859845,-0.02534324,0.0070225,0.05124921,0.06352548,-0.03244036,0.0171952,0.0131285,0.03439028,0.00137774,-0.03949432,0.02734361,-0.06749528,-0.04355238,-0.06388293,-0.04419103,0.07052674,0.00605108,-0.03294465,-0.00398025,0.0405019,-0.04889146,-0.0319245,-0.01696662,0.03982236,0.02062633,-0.04120979,0.00596859,0.00533866,-0.05331298,-0.01297993,0.00020239,-0.0068555,-0.02607251,0.10671114,-0.07054721,0.00902054,-0.0383256,-0.02562627,0.04653007,-0.0337705,0.02205401,-0.0154213,-0.05703559,-0.01385075,-0.04028497,-0.01362809,0.05860446,-0.00957862,-0.0521479,0.06248504,0.00943706,0.03556598,-0.02505318,0.00262399,0.02404486,-0.01549061,0.00418922,-0.03678834,0.02109852,0.00428047,0.04979157,0.07353614,0.04417918,0.02808036,0.03357675,0.01920364,-0.01688448,0.00980018,-0.02395955,0.00464038,-0.01799873,-0.0