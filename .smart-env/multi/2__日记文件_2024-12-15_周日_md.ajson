.07862182,-0.008096,-0.04263764,0.07105604,0.01143914,0.00280687,0.00205688,-0.02453451,0.03877063,0.25089574,0.03993061,0.01727207,-0.04120873,-0.03204479,0.05863802,0.03757456,-0.01116127,-0.02253609,0.02522574,0.06821191,-0.03550607,-0.01118078,0.02266496,-0.02273427,0.0626911,0.00754599,0.00267414,-0.06018591,0.04793751,-0.0707622,0.02057129,0.11623089,0.03390176,-0.05926914,-0.01088751,0.01287671,0.02372602,-0.01765788,0.02717486,0.01808369,0.02128184,-0.02066255,0.04726085,0.01305813,-0.0357435,-0.00466352,-0.00673965,-0.00075672,0.06763275,-0.01091406,0.06075696,0.03128526]}},"last_read":{"hash":"fb8f859c3bed7d091a3feca97535daef7a1ebd39a633802f79a0d9e7047c34c6","at":1736691166707},"class_name":"SmartSource","outlinks":[],"last_import":{"mtime":1734966672425,"size":2798,"at":1736691165484,"hash":"fb8f859c3bed7d091a3feca97535daef7a1ebd39a633802f79a0d9e7047c34c6"},"blocks":{"#":[1,1],"#**1.   行程**":[2,10],"#**1.   行程**#·  《生命管理笔记系统》进入实践篇，了解obsidian软件，并基于此构建自己的笔记系统，很适合我；":[3,3],"#**1.   行程**#·  试用并留下了喜欢的鼠标和钢笔；":[4,4],"#**1.   行程**#·   开始练字；":[5,5],"#**1.   行程**#·   谢玄《大明王朝1566》系列定场诗摘抄完毕；":[6,7],"#**1.   行程**#·   看了几款机械键盘，都买了试用后留下最喜欢的，并搭配了对应的键盘支架，放在收线盒前面刚刚好；":[8,10],"#2.   想法及反思":[11,26],"#2.   想法及反思#·  开始实践摒弃完美主义":[13,17],"#2.   想法及反思#·  开始实践摒弃完美主义#· （1） 其实新买的罗技anywhere3s鼠标也没有那么完美，但是命中了我的需求痛点“滚轮”功能，极其丝滑，以及中键可以切换软件，就让我觉得它值得这个昂贵的价格。":[14,14],"#2.   想法及反思#·  开始实践摒弃完美主义#（2）钢笔也是类似，因为处于入门阶段，所以挑了百乐88g鳄鱼纹款，颜值和手感都挺符合我的心意，写字体验也很顺滑，现阶段非常适合我；后续再进阶。":[15,15],"#2.   想法及反思#·  开始实践摒弃完美主义#（3）下午又花了时间挑机械键盘，因为笔记本离椅子较远，打字非常不方便，所以立刻把买键盘提上日程，行动力也算不错，而且挑的时候没有太纠结，而且在极小的范围内做选择，减少了时间成本。":[16,17],"#2.   想法及反思#·  工欲善其事，必先利其器":[18,21],"#2.   想法及反思#·  工欲善其事，必先利其器#（1） 键盘码字提升快乐感":[19,19],"#2.   想法及反思#·  工欲善其事，必先利其器#（2）本周成果，收拾出了一个现阶段比较完美的满足电脑/写字/整洁/电子产品方便充电等四大需求的桌面，减轻了对桌面的嫌弃和不满感，降低了做一件事情的成本，也就相应提升了 想要坐下来学习的欲望，非常好，继续保持这样的摸索精神和行动力。":[20,21],"#2.   想法及反思#·  进一步了解到自己是需求体验方面较敏感的人":[22,26],"#2.   想法及反思#·  进一步了解到自己是需求体验方面较敏感的人#（1）示例1：以前上学的时候，写字一定要保证桌面有足够的空间，供我的右胳膊摆放，否则稍微挤压一下它，我写字就很不舒服，或许从那个时候开始，就能初见端倪。":[23,23],"#2.   想法及反思#·  进一步了解到自己是需求体验方面较敏感的人#（2）示例2：买键盘码字场景，因为现在的笔记本码字很不方便，所以需要一个机械键盘来提升码字的幸福感，否则就不想做码字这件事。":[24,26],"#3.  每日终极总结":[27,30],"#3.  每日终极总结#·   我好像就是这样，如果做这件事的体验达不到我预想的标准和要求，我就一点都不想做。":[28,28],"#3.  每日终极总结#·  为了以后可以正常推进想做的事情，时间金钱成本不太高的前提下，优先去创造满足体验的条件和环境（比如这周的桌面更新计划和外设购买计划）；如果成本太高，备选方案就是降低预期体感，保证心理落差不要太大，正常做事才是最关键的。":[29,29],"#3.  每日终极总结#·  我是愿意为了体验花钱的人，比如罗技鼠标，钢笔，机械键盘等等，这个习惯没什么不好，只有经济水平允许，尽可能去满足自己。":[30,30]}},"smart_blocks:2. 日记文件/2024-12-15 周日.md#": {"path":null,"last_embed":{"hash":"6e9ba2d4743b72079ae971666d7e61f0587704fbcfcd4f874ebb2a6a700d4435","tokens":27},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07651283,-0.01816127,0.03107009,-0.05154377,0.06836359,0.0149433,-0.07241021,0.01156332,0.0241154,-0.00562586,0.001418,-0.06627614,0.02516253,0.0393928,-0.02677606,0.00803445,-0.00006465,-0.08492204,-0.04804593,-0.0011361,0.12708752,-0.02613344,0.03135977,-0.09801964,0.00912274,0.03847276,-0.02774792,-0.02654727,-0.00803862,-0.13849044,-0.05324961,-0.04591161,0.00152777,-0.00419381,0.06763019,-0.06083014,-0.02076467,0.03805627,-0.03906791,0.01453057,-0.04009221,0.04996238,0.02832832,-0.03557085,-0.00347994,-0.06529059,-0.05039004,0.01563561,-0.01438301,-0.02910856,-0.02219532,-0.03577725,0.01993857,0.02912078,0.03855043,0.01789811,0.00670994,0.00724587,0.01249026,0.06925192,0.04756165,0.05326422,-0.23023701,0.01766431,-0.02118169,0.00461945,-0.02915081,0.00178614,0.01163956,0.05392496,-0.07064682,0.02677087,0.01793937,0.04512058,0.01099544,-0.05526313,0.00855232,-0.03669591,-0.0388122,-0.05826897,-0.00587021,0.0541167,-0.01117687,-0.04155948,-0.0564189,0.00475396,-0.00360629,-0.01424309,0.00063067,0.0087845,-0.02355704,-0.00632087,0.04467404,0.01583604,-0.06953719,0.01321623,0.02556063,0.02287784,0.00158761,0.10918559,-0.06781928,0.03903932,0.02388105,-0.01890105,0.01815245,-0.03383112,-0.02146675,-0.03048106,-0.00234436,-0.03508741,-0.02470789,-0.02880789,0.07712457,-0.02664365,0.01224116,0.04592717,0.06333896,0.04139265,-0.02259981,0.00834108,0.