47726,0.03173613,0.01129524,0.05165242,-0.00868908,-0.05337704,-0.01494183,-0.06528383,0.03826202,0.01401075,0.01509833,0.03165219,0.0065243,0.02286961,0.22610831,-0.02053536,0.07769482,0.01898574,0.00253615,0.02405121,0.07848431,0.02003896,-0.00113443,-0.01925957,0.14003441,0.01188147,0.01019307,0.02284328,-0.00909745,0.04807532,-0.04019466,0.01583253,-0.06126186,0.06006676,-0.0612305,0.01504514,0.09629127,0.06134963,-0.03924482,-0.04915986,-0.01067453,0.04822762,0.01746104,0.00898279,0.02773897,0.0366723,-0.03610108,0.05910646,0.03476226,-0.0413818,-0.03148269,0.00645764,0.00626841,0.01312688,0.006881,0.06547526,0.02980396]}},"last_read":{"hash":"0d34bd65a62a355fc0728449e27613f4cb3d98cf831c0170e6623c91d4e87148","at":1755051822544},"class_name":"SmartSource","outlinks":[{"title":"Article","target":"Article","line":1},{"title":"ReadItLater","target":"ReadItLater","line":1},{"title":"神速Hash（下）","target":"https://www.playoffer.cn/3284.html","line":3},{"title":"神速Hash阅读\\","target":"https://www.playoffer.cn/3282.html）\n\n### 链地址法\n\n次日清晨，大臣们按时上朝，接着讨论昨日的话题\n\n“昨日Hash函数的选择我们已经有了具体的方案了，那就只剩下冲突的解决问题了”，王大臣率先发话\n\n“要解决冲突其实也不难，既然会有多个元素被Hash到同一个位置，而这个位置只能存储一个元素，那么我让这个位置可以存储多个元素不就可以了吗？”，何大臣说道\n\n“哦，怎么个弄法？”王大臣问道\n\n“用链表啊，来一个元素加一个，让这个位置存储一个指针，指向一个链表，让所有相同位置的元素都放在这个链表中”，何大臣回答道，接着又画了一个图\n\n![图片](https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649449.png","line":5},{"title":"图片","target":"https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649614.png","line":39},{"title":"图片","target":"https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649893.png","line":51},{"title":"图片","target":"https://shuaidi-picture-1257337429.cos.ap-guangzhou.myqcloud.com/img/202311291649243.png","line":75}],"last_import":{"mtime":1755048681268,"size":6264,"at":1755051821087,"hash":"0d34bd65a62a355fc0728449e27613f4cb3d98cf831c0170e6623c91d4e87148"},"blocks":{"#":[1,2],"#[神速Hash（下）](https://www.playoffer.cn/3284.html)":[3,95],"#